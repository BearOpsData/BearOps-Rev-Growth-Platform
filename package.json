{
  "name": "bearops-rev-growth-platform",
  "version": "1.0.0",
  "description": "BearOps Revenue Growth Platform - Full Stack Web Application",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:regression": "jest __tests__/regression/critical-paths.test.tsx __tests__/regression/backward-compatibility.test.tsx",
    "test:snapshot": "jest __tests__/regression/snapshot.test.tsx -u",
    "test:merge-validation": "jest __tests__/regression/merge-validation.test.tsx",
    "test:security": "jest __tests__/security",
    "test:all": "npm run test && npm run test:regression && npm run test:security",
    "test:ci": "npm run lint && npm run test && npm run test:regression",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:check": "npm run security:audit && npm run lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin-user.ts"
  },
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next-auth": "^4.24.5",
    "@prisma/client": "^5.9.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "prisma": "^5.9.1",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
